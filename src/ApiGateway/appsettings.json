{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/catalog/{**catch-all}"
        }
      },
      "booking-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/bookings/{**catch-all}"
        }
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "concierge-route": {
        "ClusterId": "concierge-cluster",
        "Match": {
          "Path": "/api/concierge/{**catch-all}"
        }
      },
      "catalog-swagger-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/swagger-docs/catalog/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/swagger-docs/catalog" }
        ]
      },
      "booking-swagger-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/swagger-docs/booking/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/swagger-docs/booking" }
        ]
      },
      "notification-swagger-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/swagger-docs/notification/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/swagger-docs/notification" }
        ]
      },
      "concierge-swagger-route": {
        "ClusterId": "concierge-cluster",
        "Match": {
          "Path": "/swagger-docs/concierge/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/swagger-docs/concierge" }
        ]
      }
    },
    "Clusters": {
      "catalog-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5101/"
          }
        }
      },
      "booking-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5102/"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5103/"
          }
        }
      },
      "concierge-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5104/"
          }
        }
      }
    }
  }
}
